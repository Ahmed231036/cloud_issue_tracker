@baseUrl = http://localhost:3000

### T01 View all issues
GET {{baseUrl}}/api/issues

### T02 Create a valid issue
POST {{baseUrl}}/api/issues
Content-Type: application/json

{
	"title": "Printer unavailable",
	"description": "The shared printer is not responding.",
	"priority": "Medium"
}

### T03 Invalid create: missing title
POST {{baseUrl}}/api/issues
Content-Type: application/json

{
	"title": "",
	"description": "Missing valid title",
	"priority": "Urgent"
}

### T05 Change status (replace the ID)
PATCH {{baseUrl}}/api/issues/<issue-id>/status
Content-Type: application/json

{ "status": "Resolved" }

### T06 Invalid status
PATCH {{baseUrl}}/api/issues/<issue-id>/status
Content-Type: application/json

{ "status": "Deleted" }

### T07 Update unknown issue
PATCH {{baseUrl}}/api/issues/does-not-exist/status
Content-Type: application/json

{ "status": "Resolved" }

### T10 Create without JSON
POST {{baseUrl}}/api/issues
Content-Type: text/plain

title=Printer

### T11 Create with malformed JSON
POST {{baseUrl}}/api/issues
Content-Type: application/json

{ "title": "Printer", }

### T12 Unknown route
PATCH {{baseUrl}}/api/fake-url
